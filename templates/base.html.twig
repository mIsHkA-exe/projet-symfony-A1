<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Bienvenue{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('css/style_accueil.css') }}">
        {% block stylesheets %}{% endblock %}
    </head>
    
    <body>
        <nav class="main-nav">
            {# --- ZONE UTILISATEUR CONNECTÉ --- #}
            {% if app.user %}
                <div class="user-top-bar">
                    <span class="user-name">Bonjour {{ app.user.prenom }} !</span>
                    <a href="{{ path('app_logout') }}" class="btn-logout">Déconnexion</a>
                </div>
            {% endif %}

        </nav>

        {% block body %}{% endblock %}
        
        {% block javascripts %}{% endblock %}
    </body>

    {% for message in app.flashes('error') %}
    <div style="background: red; color: white; padding: 10px; text-align: center;">
        {{ message }}
    </div>
    {% endfor %}

    {% if is_granted('ROLE_ADMIN') %}
    <li><a href="{{ path('admin_spectacle_index') }}" style="color: red;">Espace Admin</a></li>
    {% endif %}

</html>